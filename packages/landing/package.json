{
    "name": "@budgie-at/landing",
    "version": "5.32.2",
    "private": true,
    "scripts": {
        "build": "next build",
        "clear": "yarn run -T rimraf dist .next node_modules/.cache .turbo",
        "i18n:compile": "run -T lingui compile --typescript",
        "i18n:extract": "run -T lingui extract --overwrite --clean",
        "i18n:sync": "yarn i18n:extract && yarn i18n:compile",
        "lint": "run -T eslint --fix .",
        "release:start": "next start",
        "start": "next dev",
        "ts": "run -T tsc -p ."
    },
    "dependencies": {
        "@lingui/core": "6.1.0",
        "@lingui/react": "6.1.0",
        "@radix-ui/react-accordion": "^1.2.12",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-slot": "^1.2.4",
        "@rnw-community/shared": "^2.2.0",
        "autoprefixer": "^10.5.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.3.0",
        "framer-motion": "^12.40.0",
        "lucide-react": "^1.17.0",
        "negotiator": "^1.0.0",
        "next": "16.2.7",
        "next-themes": "^0.4.6",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "redis": "^5.11.0",
        "server-only": "^0.0.1",
        "tailwind-merge": "^3.6.0",
        "tailwindcss-animate": "^1.0.7"
    },
    "devDependencies": {
        "@lingui/format-po": "6.1.0",
        "@lingui/loader": "6.1.0",
        "@lingui/swc-plugin": "6.3.0",
        "@tailwindcss/postcss": "^4.3.0",
        "@types/negotiator": "^0.6.4",
        "babel-plugin-react-compiler": "^1.0.0",
        "postcss": "^8.5.15",
        "tailwindcss": "^4.3.0"
    }
}
