{
    "name": "@budgie-at/landing",
    "version": "6.126.0",
    "private": true,
    "scripts": {
        "build": "pnpm media:check && next build",
        "clear": "rimraf dist .next node_modules/.cache .turbo",
        "i18n:compile": "lingui compile --strict --typescript && node scripts/i18n-client-catalog.mjs",
        "i18n:extract": "lingui extract --overwrite --clean",
        "i18n:sync": "pnpm i18n:extract && pnpm i18n:compile",
        "lint": "oxlint --type-aware .",
        "lint:fix": "oxlint --type-aware --fix .",
        "media:check": "node scripts/media-manifest.mjs --check && node scripts/og-plate.mjs --check",
        "media:manifest": "node scripts/media-manifest.mjs",
        "media:og": "node scripts/og-plate.mjs",
        "release:start": "next start",
        "start": "next dev",
        "ts": "node ../../scripts/typecheck.cjs --noEmit -p tsconfig.json",
        "ts:native": "node ../../scripts/typecheck.cjs --native --noEmit -p tsconfig.json"
    },
    "dependencies": {
        "@lingui/core": "6.10.1",
        "@lingui/react": "6.10.1",
        "@radix-ui/react-accordion": "^1.3.1",
        "@radix-ui/react-dropdown-menu": "^2.2.1",
        "@radix-ui/react-slot": "^1.5.0",
        "@rnw-community/shared": "^2.28.0",
        "autoprefixer": "^10.6.1",
        "class-variance-authority": "^0.7.1",
        "cn": "0.5.0",
        "date-fns": "^4.4.0",
        "effect": "4.0.6",
        "negotiator": "^1.1.0",
        "next": "16.4.3",
        "next-themes": "^0.4.6",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "redis": "^6.3.0",
        "reicon-react": "^1.2.6",
        "server-only": "^0.0.1",
        "tailwindcss-animate": "^1.0.7"
    },
    "devDependencies": {
        "@lingui/format-po": "6.10.1",
        "@lingui/loader": "6.10.1",
        "@lingui/swc-plugin": "6.7.1",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/negotiator": "^0.6.5",
        "babel-plugin-react-compiler": "^1.0.0",
        "postcss": "^8.5.30",
        "tailwindcss": "^4.3.3"
    }
}
