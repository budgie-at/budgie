    "devDependencies": {
        "@lingui/loader": "^5.7.0",
        "@lingui/swc-plugin": "5.7.0",
        "@tailwindcss/postcss": "^4.1.14",
        "@types/mdx": "^2.0.13",
        "@types/negotiator": "^0.6.3",
        "babel-plugin-react-compiler": "^1.0.0",
        "postcss": "^8.5.6",
        "tailwindcss": "^4.1.14"
    }
