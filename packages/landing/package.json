        "@radix-ui/react-slot": "^1.2.3",
        "@rnw-community/shared": "^1.8.2",
        "autoprefixer": "^10.4.21",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.1.0",
        "framer-motion": "^12.23.22",
        "lucide-react": "^0.544.0",
        "negotiator": "^1.0.0",
        "next": "^15.5.4",
        "next-themes": "^0.4.6",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "server-only": "^0.0.1",
        "tailwind-merge": "^2.5.5",
        "tailwindcss-animate": "^1.0.7"
