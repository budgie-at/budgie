{
    "name": "@budgie-at/landing",
    "version": "1.48.0",
    "private": true,
    "scripts": {
        "build": "next build --turbo",
        "release:start": "next start",
        "start": "next dev --turbo",
        "lint": "run -T eslint --fix .",
