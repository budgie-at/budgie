msgstr "Ein Schalter in den Einstellungen, unter Sicherheit"

#: src/app/[lang]/ai-features/page.tsx
msgid "One switch, downloads on demand"
msgstr "Ein Schalter, Downloads bei Bedarf"

#: src/app/[lang]/features/screenshot-protection/page.tsx
msgid "One switch, off by default, sitting directly under the PIN-lock card in the Security section."
msgstr "Ein Schalter, standardmäßig deaktiviert, direkt unter der PIN-Sperre-Karte im Bereich Sicherheit."

#: src/app/[lang]/features/primary-tag/page.tsx
msgid "One tag chip per row on the transaction list — scan without opening rows"
msgstr "Ein Tag-Chip pro Zeile in der Transaktionsliste – scannen, ohne Zeilen zu öffnen"

#: src/app/[lang]/features/transaction-tags/page.tsx
msgid "One tag chip, plus a count"
msgstr "Ein Tag-Chip plus Anzahl"

#: src/app/[lang]/features/primary-tag/page.tsx
msgid "One tag needs no border"
msgstr "Ein Tag braucht keine Umrandung"

#: src/app/[lang]/features/primary-tag/metadata.ts
msgid "One tag per row. Scan a long list at a glance."
msgstr "Ein Tag pro Zeile. Eine lange Liste auf einen Blick erfassen."

#: src/app/[lang]/features/transaction-tags/page.tsx
msgid "One tag per transaction can be promoted to “primary” and stands out as a highlighted pill"
msgstr "Ein Tag pro Transaktion kann zum „primären“ befördert werden und sticht als hervorgehobenes Pill hervor"

#: src/app/[lang]/features/ai-tag-suggestions/page.tsx
#: src/app/[lang]/features/dark-mode/page.tsx
#: src/app/[lang]/features/mcc-auto-category/page.tsx
msgid "One tap"
msgstr "Ein Tipp"

#: src/app/[lang]/features/data-export/page.tsx
msgid "One tap exports your whole history — no range to pick, and deleted or merged-away rows stay out"
msgstr "Ein Tipp exportiert deinen ganzen Verlauf — kein Zeitraum zu wählen, gelöschte oder weggemergte Zeilen bleiben draußen"

#: src/app/[lang]/features/voice-transaction-entry/page.tsx
