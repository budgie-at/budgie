#: src/app/[lang]/features/spending-analytics/page.tsx
msgid "One tap switches every total and category row."
msgstr "Ein Tipp schaltet jede Summe und jede Kategoriezeile um."

#: src/app/[lang]/features/uncategorized-transactions/page.tsx
