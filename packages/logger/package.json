{
    "name": "@budgie/logger",
    "version": "6.4.0",
    "private": true,
    "description": "Shared logging primitives: console transport, build-time disable gate, @Log decorator, getLogger",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/esm/index.d.ts",
            "import": "./dist/esm/index.js",
            "react-native": "./dist/esm/index.js",
            "default": "./dist/esm/index.js"
        },
        "./package.json": "./package.json"
    },
    "main": "./dist/esm/index.js",
    "react-native": "./dist/esm/index.js",
    "types": "./dist/esm/index.d.ts",
    "scripts": {
        "build": "node ../../node_modules/@typescript/native/bin/tsc -p tsconfig.json",
        "build:watch": "pnpm build --watch",
        "clear": "rimraf dist node_modules/.cache .turbo",
        "format": "oxfmt --write src",
        "lint": "oxlint --type-aware src && eslint src",
        "lint:eslint": "eslint src",
        "lint:fix": "oxlint --type-aware --fix src && eslint --fix src",
        "test": "jest --passWithNoTests",
        "ts": "node ../../node_modules/@typescript/native/bin/tsc -p ."
    },
    "dependencies": {
        "@rnw-community/log-decorator": "^2.2.0",
        "@rnw-community/shared": "^2.2.0"
    }
}
