{
    "name": "@budgie/ai",
    "version": "5.43.3",
    "private": true,
    "description": "AI services for transaction categorization, embedding suggestions, and voice extraction",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/esm/index.d.ts",
            "import": "./dist/esm/index.js",
            "react-native": "./dist/esm/index.js",
            "default": "./dist/esm/index.js"
        },
        "./package.json": "./package.json"
    },
    "main": "./dist/esm/index.js",
    "react-native": "./dist/esm/index.js",
    "types": "./dist/esm/index.d.ts",
    "scripts": {
        "build": "node ../../node_modules/@typescript/native/bin/tsc -p tsconfig.json",
        "build:watch": "yarn build --watch",
        "clear": "yarn run -T rimraf dist node_modules/.cache .turbo",
        "format": "run -T oxfmt --write src",
        "lint": "run -T oxlint --type-aware src && run -T eslint src",
        "lint:eslint": "run -T eslint src",
        "lint:fix": "run -T oxlint --type-aware --fix src && run -T eslint --fix src",
        "test": "run -T jest --passWithNoTests",
        "test:cov": "run -T jest --coverage",
        "test:watch": "run -T jest --watch",
        "ts": "node ../../node_modules/@typescript/native/bin/tsc -p ."
    },
    "dependencies": {
        "@budgie/contracts": "workspace:^",
        "@budgie/logger": "workspace:*",
        "@rnw-community/shared": "^2.2.0",
        "zod": "4.1.12"
    }
}
