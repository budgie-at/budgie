{
    "name": "@budgie/contracts",
    "version": "6.5.1",
    "private": true,
    "description": "Contracts",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/esm/index.d.ts",
            "import": "./dist/esm/index.js",
            "react-native": "./dist/esm/index.js",
            "default": "./dist/esm/index.js"
        },
        "./package.json": "./package.json"
    },
    "main": "./dist/esm/index.js",
    "react-native": "./dist/esm/index.js",
    "types": "./dist/esm/index.d.ts",
    "scripts": {
        "build": "node ../../node_modules/@typescript/native/bin/tsc -p tsconfig.json",
        "build:watch": "pnpm build --watch",
        "clear": "rimraf dist node_modules/.cache .turbo",
        "format": "oxfmt --write src",
        "lint": "oxlint --type-aware src && eslint src",
        "lint:eslint": "eslint src",
        "lint:fix": "oxlint --type-aware --fix src && eslint --fix src",
        "test": "jest --passWithNoTests",
        "test:cov": "jest --coverage",
        "test:watch": "jest --watch",
        "ts": "node ../../node_modules/@typescript/native/bin/tsc -p ."
    },
    "dependencies": {
        "@budgie/logger": "workspace:*",
        "@rnw-community/shared": "^2.2.0",
        "date-fns": "^4.3.0",
        "drizzle-orm": "^0.45.2",
        "drizzle-zod": "^0.8.3",
        "expo-sqlite": "~57.0.0",
        "zod": "4.1.12"
    }
}
