{
    "name": "@budgie/contracts",
    "version": "6.106.1",
    "private": true,
    "description": "Contracts",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/esm/index.d.ts",
            "default": "./dist/esm/index.js"
        },
        "./schema": {
            "types": "./dist/esm/schema.d.ts",
            "default": "./dist/esm/schema.js"
        },
        "./package.json": "./package.json"
    },
    "main": "./dist/esm/index.js",
    "types": "./dist/esm/index.d.ts",
    "scripts": {
        "build": "node ../../node_modules/@typescript/native/bin/tsc -p tsconfig.json",
        "build:watch": "pnpm build --watch",
        "clear": "rimraf dist node_modules/.cache .turbo",
        "format": "oxfmt --write src test",
        "lint": "oxlint --type-aware src",
        "lint:fix": "oxlint --type-aware --fix src",
        "ts": "node ../../node_modules/@typescript/native/bin/tsc -p . && node ../../node_modules/@typescript/native/bin/tsc -p tsconfig.test.json",
        "test": "vitest run"
    },
    "dependencies": {
        "@rnw-community/shared": "^2.28.0",
        "drizzle-orm": "1.0.0-rc.4",
        "effect": "4.0.5"
    },
    "devDependencies": {
        "@effect/vitest": "4.0.5",
        "@types/node": "26.6.5",
        "vitest": "^5.0.5"
    }
}
