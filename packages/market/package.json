{
    "name": "@budgie/market",
    "version": "6.181.3",
    "private": true,
    "description": "Exchange rates, market data and base valuation services",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/esm/index.d.ts",
            "default": "./dist/esm/index.js"
        },
        "./package.json": "./package.json"
    },
    "main": "./dist/esm/index.js",
    "types": "./dist/esm/index.d.ts",
    "scripts": {
        "build": "node ../../node_modules/@typescript/native/bin/tsc -p tsconfig.json",
        "build:watch": "pnpm build --watch",
        "clear": "rimraf dist node_modules/.cache .turbo",
        "lint": "oxlint --type-aware src",
        "test": "vitest run",
        "bench:yield": "vitest run --config vitest.bench.config.ts",
        "ts": "node ../../scripts/typecheck.cjs --noEmit -p tsconfig.json && node ../../scripts/typecheck.cjs --noEmit -p tsconfig.test.json",
        "ts:native": "node ../../scripts/typecheck.cjs --native --noEmit -p tsconfig.json && node ../../scripts/typecheck.cjs --native --noEmit -p tsconfig.test.json"
    },
    "dependencies": {
        "@budgie/contracts": "workspace:^",
        "@rnw-community/shared": "^3.0.5",
        "date-fns": "^4.4.0",
        "drizzle-orm": "1.0.0-rc.4",
        "effect": "4.1.2"
    },
    "devDependencies": {
        "@budgie-at/test-kit": "workspace:*",
        "@effect/sql-sqlite-node": "4.1.2",
        "@effect/vitest": "4.1.2",
        "@types/node": "26.6.6",
        "vitest": "5.1.0"
    }
}
