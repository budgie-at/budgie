{
    "name": "@budgie/sync",
    "version": "6.5.2",
    "private": true,
    "description": "Bank synchronization package with multi-bank support",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/esm/index.d.ts",
            "import": "./dist/esm/index.js",
            "react-native": "./dist/esm/index.js",
            "default": "./dist/esm/index.js"
        },
        "./package.json": "./package.json"
    },
    "main": "./dist/esm/index.js",
    "react-native": "./dist/esm/index.js",
    "types": "./dist/esm/index.d.ts",
    "scripts": {
        "build": "node ../../node_modules/@typescript/native/bin/tsc -p tsconfig.json",
        "build:watch": "pnpm build --watch",
        "clear": "rimraf dist node_modules/.cache .turbo",
        "format": "oxfmt --write src",
        "lint": "oxlint --type-aware src && eslint src",
        "lint:eslint": "eslint src",
        "lint:fix": "oxlint --type-aware --fix src && eslint --fix src",
        "ts": "node ../../node_modules/@typescript/native/bin/tsc -p ."
    },
    "dependencies": {
        "@budgie/logger": "workspace:*",
        "@liaugust/monobank-sdk": "^0.7.0",
        "@noble/hashes": "^1.8.0",
        "@rnw-community/shared": "^2.2.0",
        "date-fns": "^4.3.0",
        "ky": "^2.1.0",
        "xlsx": "^0.18.5",
        "zod": "4.5.1"
    }
}
