{
    "name": "@budgie/sync",
    "version": "6.173.1",
    "private": true,
    "description": "Bank synchronization package with multi-bank support",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/esm/index.d.ts",
            "default": "./dist/esm/index.js"
        },
        "./e2e": {
            "types": "./dist/esm/e2e/e2e-fake-api.d.ts",
            "default": "./dist/esm/e2e/e2e-fake-api.js"
        },
        "./package.json": "./package.json"
    },
    "main": "./dist/esm/index.js",
    "types": "./dist/esm/index.d.ts",
    "scripts": {
        "build": "node ../../node_modules/@typescript/native/bin/tsc -p tsconfig.json",
        "build:watch": "pnpm build --watch",
        "clear": "rimraf dist node_modules/.cache .turbo",
        "format": "oxfmt --write src",
        "lint": "oxlint --type-aware src",
        "lint:fix": "oxlint --type-aware --fix src",
        "probe:binance": "node --experimental-strip-types scripts/binance-live-probe.ts",
        "ts": "node ../../scripts/typecheck.cjs --noEmit -p tsconfig.json",
        "ts:native": "node ../../scripts/typecheck.cjs --native --noEmit -p tsconfig.json"
    },
    "dependencies": {
        "@budgie/consolidation": "workspace:*",
        "@budgie/contracts": "workspace:^",
        "@budgie/ledger": "workspace:*",
        "@budgie/market": "workspace:*",
        "@budgie/rules": "workspace:*",
        "@liaugust/monobank-sdk": "^0.8.0",
        "@noble/hashes": "^2.4.0",
        "@rnw-community/shared": "^3.0.5",
        "date-fns": "^4.4.0",
        "drizzle-orm": "1.0.0-rc.4",
        "effect": "4.1.2",
        "xlsx": "^0.18.5"
    }
}
