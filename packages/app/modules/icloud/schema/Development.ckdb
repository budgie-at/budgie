DEFINE SCHEMA

    RECORD TYPE Backup (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        createdAt       TIMESTAMP QUERYABLE SORTABLE,
        installId       STRING QUERYABLE,
        deviceName      STRING,
        deviceModel     STRING,
        appVersion      STRING,
        schemaVersion   INT64,
        archive         ASSET,
        backupKey       ENCRYPTED STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Account (
        "___createTime"          TIMESTAMP,
        "___createdBy"           REFERENCE,
        "___etag"                STRING,
        "___modTime"             TIMESTAMP,
        "___modifiedBy"          REFERENCE,
        "___recordID"            REFERENCE QUERYABLE,
        schemaVersion            INT64,
        booleanFields            ENCRYPTED STRING,
        createdAt                ENCRYPTED DOUBLE,
        updatedAt                ENCRYPTED DOUBLE,
        deletedAt                ENCRYPTED DOUBLE,
        icon                     ENCRYPTED STRING,
        parentSyncId             ENCRYPTED STRING,
        order                    ENCRYPTED DOUBLE,
        title                    ENCRYPTED STRING,
        type                     ENCRYPTED STRING,
        nature                   ENCRYPTED STRING,
        debtType                 ENCRYPTED STRING,
        instrumentCode           ENCRYPTED STRING,
        externalId               ENCRYPTED STRING,
        deadline                 ENCRYPTED DOUBLE,
        targetBalance            ENCRYPTED DOUBLE,
        targetBaseInstrumentCode ENCRYPTED STRING,
        targetBaseExchangeRate   ENCRYPTED DOUBLE,
        targetBaseAmount         ENCRYPTED DOUBLE,
        interestRate             ENCRYPTED DOUBLE,
        installmentCount         ENCRYPTED DOUBLE,
        externalSource           ENCRYPTED STRING,
        integrationSyncId        ENCRYPTED STRING,
        iban                     ENCRYPTED STRING,
        includeInNetWorth        ENCRYPTED INT64,
        isActive                 ENCRYPTED INT64,
        isExternal               ENCRYPTED INT64,
        externalIds              ENCRYPTED STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE BankIntegration (
        "___createTime"  TIMESTAMP,
        "___createdBy"   REFERENCE,
        "___etag"        STRING,
        "___modTime"     TIMESTAMP,
        "___modifiedBy"  REFERENCE,
        "___recordID"    REFERENCE QUERYABLE,
        schemaVersion    INT64,
        booleanFields    ENCRYPTED STRING,
        createdAt        ENCRYPTED DOUBLE,
        updatedAt        ENCRYPTED DOUBLE,
        deletedAt        ENCRYPTED DOUBLE,
        provider         ENCRYPTED STRING,
        label            ENCRYPTED STRING,
        externalClientId ENCRYPTED STRING,
        ownerInstallId   ENCRYPTED STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Budget (
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE QUERYABLE,
        schemaVersion          INT64,
        booleanFields          ENCRYPTED STRING,
        createdAt              ENCRYPTED DOUBLE,
        updatedAt              ENCRYPTED DOUBLE,
        deletedAt              ENCRYPTED DOUBLE,
        name                   ENCRYPTED STRING,
        kind                   ENCRYPTED STRING,
        period                 ENCRYPTED STRING,
        periodStartDay         ENCRYPTED DOUBLE,
        useLastDayOfMonth      ENCRYPTED INT64,
        periodAnchorDate       ENCRYPTED DOUBLE,
        overallLimit           ENCRYPTED DOUBLE,
        otherLimit             ENCRYPTED DOUBLE,
        otherLimitUserEditedAt ENCRYPTED DOUBLE,
        limitSource            ENCRYPTED STRING,
        isAutoTuneEnabled      ENCRYPTED INT64,
        otherRolloverMode      ENCRYPTED STRING,
        tagSyncId              ENCRYPTED STRING,
        startsAt               ENCRYPTED DOUBLE,
        endsAt                 ENCRYPTED DOUBLE,
        instrumentCode         ENCRYPTED STRING,
        categoryLimits         ENCRYPTED STRING,
        sinkingFunds           ENCRYPTED STRING,
        limitChanges           ENCRYPTED STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Category (
        "___createTime"  TIMESTAMP,
        "___createdBy"   REFERENCE,
        "___etag"        STRING,
        "___modTime"     TIMESTAMP,
        "___modifiedBy"  REFERENCE,
        "___recordID"    REFERENCE QUERYABLE,
        schemaVersion    INT64,
        booleanFields    ENCRYPTED STRING,
        createdAt        ENCRYPTED DOUBLE,
        updatedAt        ENCRYPTED DOUBLE,
        deletedAt        ENCRYPTED DOUBLE,
        title            ENCRYPTED STRING,
        icon             ENCRYPTED STRING,
        iconSource       ENCRYPTED STRING,
        parentSyncId     ENCRYPTED STRING,
        isDefault        ENCRYPTED INT64,
        isSystemCategory ENCRYPTED INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE DebtEvent (
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE QUERYABLE,
        schemaVersion          INT64,
        booleanFields          ENCRYPTED STRING,
        createdAt              ENCRYPTED DOUBLE,
        updatedAt              ENCRYPTED DOUBLE,
        deletedAt              ENCRYPTED DOUBLE,
        debtAccountSyncId      ENCRYPTED STRING,
        transactionSyncId      ENCRYPTED STRING,
        transactionEntrySyncId ENCRYPTED STRING,
        direction              ENCRYPTED STRING,
        source                 ENCRYPTED STRING,
        operatedAt             ENCRYPTED DOUBLE,
        amount                 ENCRYPTED DOUBLE,
        baseAmount             ENCRYPTED DOUBLE,
        baseExchangeRate       ENCRYPTED DOUBLE,
        baseInstrumentCode     ENCRYPTED STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE RecurringSeries (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        schemaVersion   INT64,
        booleanFields   ENCRYPTED STRING,
        createdAt       ENCRYPTED DOUBLE,
        updatedAt       ENCRYPTED DOUBLE,
        deletedAt       ENCRYPTED DOUBLE,
        merchantKey     ENCRYPTED STRING,
        kind            ENCRYPTED STRING,
        periodDays      ENCRYPTED DOUBLE,
        amount          ENCRYPTED DOUBLE,
        status          ENCRYPTED STRING,
        userState       ENCRYPTED STRING,
        title           ENCRYPTED STRING,
        categorySyncId  ENCRYPTED STRING,
        lastSeenAt      ENCRYPTED DOUBLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Rule (
        "___createTime"    TIMESTAMP,
        "___createdBy"     REFERENCE,
        "___etag"          STRING,
        "___modTime"       TIMESTAMP,
        "___modifiedBy"    REFERENCE,
        "___recordID"      REFERENCE QUERYABLE,
        schemaVersion      INT64,
        booleanFields      ENCRYPTED STRING,
        createdAt          ENCRYPTED DOUBLE,
        updatedAt          ENCRYPTED DOUBLE,
        deletedAt          ENCRYPTED DOUBLE,
        enabled            ENCRYPTED INT64,
        conditionMatchType ENCRYPTED STRING,
        conditions         ENCRYPTED STRING,
        actions            ENCRYPTED STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Tag (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        schemaVersion   INT64,
        booleanFields   ENCRYPTED STRING,
        createdAt       ENCRYPTED DOUBLE,
        updatedAt       ENCRYPTED DOUBLE,
        deletedAt       ENCRYPTED DOUBLE,
        title           ENCRYPTED STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Transaction (
        "___createTime"                      TIMESTAMP,
        "___createdBy"                       REFERENCE,
        "___etag"                            STRING,
        "___modTime"                         TIMESTAMP,
        "___modifiedBy"                      REFERENCE,
        "___recordID"                        REFERENCE QUERYABLE,
        schemaVersion                        INT64,
        booleanFields                        ENCRYPTED STRING,
        createdAt                            ENCRYPTED DOUBLE,
        updatedAt                            ENCRYPTED DOUBLE,
        deletedAt                            ENCRYPTED DOUBLE,
        type                                 ENCRYPTED STRING,
        title                                ENCRYPTED STRING,
        externalId                           ENCRYPTED STRING,
        operatedAt                           ENCRYPTED DOUBLE,
        comment                              ENCRYPTED STRING,
        toAccountSyncId                      ENCRYPTED STRING,
        fromAccountSyncId                    ENCRYPTED STRING,
        exchangeRate                         ENCRYPTED DOUBLE,
        externalSource                       ENCRYPTED STRING,
        updatedBy                            ENCRYPTED STRING,
        importFingerprint                    ENCRYPTED STRING,
        consolidationParentTransactionSyncId ENCRYPTED STRING,
        consolidationType                    ENCRYPTED STRING,
        entries                              ENCRYPTED STRING,
        tags                                 ENCRYPTED STRING,
        receipts                             ENCRYPTED STRING,
        legEntryPrivate                      ENCRYPTED STRING,
        linkId                               ENCRYPTED STRING,
        legCount                             ENCRYPTED DOUBLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE TransactionLeg (
        "___createTime"   TIMESTAMP,
        "___createdBy"    REFERENCE,
        "___etag"         STRING,
        "___modTime"      TIMESTAMP,
        "___modifiedBy"   REFERENCE,
        "___recordID"     REFERENCE QUERYABLE,
        schemaVersion     INT64,
        booleanFields     ENCRYPTED STRING,
        createdAt         ENCRYPTED DOUBLE,
        updatedAt         ENCRYPTED DOUBLE,
        deletedAt         ENCRYPTED DOUBLE,
        type              ENCRYPTED STRING,
        operatedAt        ENCRYPTED DOUBLE,
        toAccountSyncId   ENCRYPTED STRING,
        fromAccountSyncId ENCRYPTED STRING,
        entries           ENCRYPTED STRING,
        linkId            ENCRYPTED STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE SyncMeta (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        schemaVersion   INT64,
        booleanFields   ENCRYPTED STRING,
        lineageId       ENCRYPTED STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE SyncDevice (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        schemaVersion   INT64,
        booleanFields   ENCRYPTED STRING,
        installId       ENCRYPTED STRING,
        lastSyncedAt    ENCRYPTED DOUBLE,
        deviceName      ENCRYPTED STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );

    RECORD TYPE "cloudkit.share" (
        "___createTime"               TIMESTAMP,
        "___createdBy"                REFERENCE,
        "___etag"                     STRING,
        "___modTime"                  TIMESTAMP,
        "___modifiedBy"               REFERENCE,
        "___recordID"                 REFERENCE QUERYABLE,
        "cloudkit.thumbnailImageData" BYTES,
        "cloudkit.title"              STRING,
        "cloudkit.type"               STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );
