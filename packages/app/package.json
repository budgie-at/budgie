        "react-native-gesture-handler": "~2.32.0",
        "react-native-keyboard-controller": "1.22.4",
        "react-native-reanimated": "4.6.0",
        "react-native-safe-area-context": "~5.7.0",
        "react-native-screens": "4.26.0",
        "react-native-svg": "15.15.4",
        "react-native-toast-message": "^2.4.0",
        "react-native-ui-datepicker": "^3.3.0",
        "react-native-web": "^0.21.0",
        "react-native-webview": "13.16.1",
        "react-native-worklets": "0.12.1",
        "tailwind-merge": "^3.6.0",
        "whisper.rn": "^0.7.4",
        "zod": "4.5.1"
    },
    "devDependencies": {
        "@babel/core": "7.29.7",
        "@babel/plugin-transform-class-static-block": "7.29.7",
        "@expo/metro-config": "57.0.12",
        "@lingui/babel-plugin-lingui-macro": "6.5.0",
        "@lingui/cli": "6.5.0",
        "@lingui/format-po": "6.5.0",
        "@react-native/metro-config": "0.86.3",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/babel__core": "^7",
        "@types/better-sqlite3": "^7.6.13",
        "@types/papaparse": "^5",
        "babel-plugin-inline-import": "^3.0.0",
        "babel-plugin-macros": "^3.1.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "babel-preset-expo": "57.0.9",
        "better-sqlite3": "^12.10.0",
        "drizzle-kit": "^0.31.10",
        "eas-build-cache-provider": "^19.0.0",
        "lightningcss": "1.30.1",
        "postcss": "^8.5.26",
        "tailwindcss": "^4.3.3"
    }
