{
    "name": "@budgie-at/app",
    "version": "2.31.0",
    "private": true,
    "scripts": {
        "android": "expo run:android",
        "clear": "yarn run -T rimraf dist node_modules/.cache .turbo .expo",
        "i18n:compile": "run -T lingui compile --typescript",
        "i18n:extract": "run -T lingui extract --overwrite --clean",
        "i18n:sync": "yarn i18n:extract && yarn i18n:compile",
        "ios": "APP_VARIANT=development expo run:ios",
        "ios:device": "APP_VARIANT=development expo run:ios --device",
        "lint": "run -T eslint --fix src",
        "prebuild": "expo prebuild --clean",
        "start": "expo start --dev-client -c",
        "ts": "run -T tsc -p .",
        "web": "expo start --web",
        "db:generate": "drizzle-kit generate"
    },
    "resolutions": {
        "lightningcss": "1.30.1"
    },
