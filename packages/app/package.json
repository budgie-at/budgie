        "@vnaidin/react-native-cryptocurrency-icons": "0.0.36",
        "class-variance-authority": "^0.7.1",
        "cn": "0.4.0",
        "date-fns": "^4.3.0",
        "dotenv": "^17.4.2",
        "drizzle-orm": "1.0.0-rc.4",
        "effect": "4.0.0",
        "expo": "58.0.1",
        "expo-asset": "~58.0.9",
        "expo-background-task": "~58.0.9",
        "expo-blur": "~58.0.2",
