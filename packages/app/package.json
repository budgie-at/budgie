{
    "name": "@budgie-at/app",
    "version": "6.99.1",
    "private": true,
    "scripts": {
        "android": "expo run:android",
        "bench:budget-spent": "node --experimental-strip-types scripts/bench-budget-spent.ts",
        "clear": "rimraf dist node_modules/.cache .turbo .expo",
        "db:generate": "drizzle-kit generate",
        "eas-build-post-install": "cd ../.. && pnpm build",
        "generate:icons": "node --experimental-strip-types scripts/generate-icons-constant.ts",
        "generate:typed-routes": "expo export --platform web --output-dir /tmp/expo-typed --dump-assetmap 2>/dev/null || true",
        "i18n:compile": "lingui compile --strict --typescript",
        "i18n:extract": "lingui extract --overwrite --clean",
        "i18n:sync": "pnpm i18n:extract && pnpm i18n:compile",
        "ios": "EXPO_PUBLIC_AI_DISABLE=true APP_VARIANT=development expo run:ios",
        "ios:device": "EXPO_PUBLIC_AI_DISABLE=true APP_VARIANT=development expo run:ios --device",
        "lint": "oxlint --type-aware src",
        "lint:fix": "oxlint --type-aware --fix src",
        "prebuild": "expo prebuild --clean",
        "prebuild:dev": "EXPO_PUBLIC_AI_DISABLE=true APP_VARIANT=development expo prebuild --clean",
        "start": "expo start --dev-client -c",
        "store:notes": "node --experimental-strip-types scripts/generate-store-release-notes.ts",
        "ts": "node ../../node_modules/@typescript/native/bin/tsc -p .",
        "web": "expo start --web"
    },
    "dependencies": {
        "@budgie/ai": "workspace:^",
        "@budgie/budget": "workspace:*",
        "@budgie/categorization": "workspace:*",
        "@budgie/consolidation": "workspace:*",
        "@budgie/contracts": "workspace:^",
        "@budgie/import-export": "workspace:*",
        "@budgie/ledger": "workspace:*",
        "@budgie/logger": "workspace:*",
        "@budgie/market": "workspace:*",
        "@budgie/recurring": "workspace:*",
        "@budgie/rules": "workspace:*",
        "@budgie/sync": "workspace:*",
        "@effect/atom-react": "4.0.0",
        "@effect/sql-sqlite-react-native": "4.0.0",
        "@expo/fingerprint": "~0.21.2",
        "@expo/ui": "~58.0.10",
        "@formatjs/intl": "^4.1.19",
        "@formatjs/intl-pluralrules": "^6.3.15",
        "@hookform/resolvers": "^5.9.1",
        "@legendapp/list": "^3.6.0",
        "@lingui/core": "6.6.0",
        "@lingui/react": "6.6.0",
        "@op-engineering/op-sqlite": "18.2.5",
