{
    "name": "@budgie-at/app",
    "version": "6.5.1",
    "private": true,
    "scripts": {
        "android": "expo run:android",
        "bench:budget-spent": "node --experimental-strip-types scripts/bench-budget-spent.ts",
        "clear": "rimraf dist node_modules/.cache .turbo .expo",
        "db:generate": "drizzle-kit generate",
        "eas-build-post-install": "cd ../.. && pnpm build",
        "generate:typed-routes": "expo export --platform web --output-dir /tmp/expo-typed --dump-assetmap 2>/dev/null || true",
        "i18n:compile": "lingui compile --typescript",
        "i18n:extract": "lingui extract --overwrite --clean",
        "i18n:sync": "pnpm i18n:extract && pnpm i18n:compile",
        "postinstall": "cp -R patches/expo-sqlite-vec-ios/vec.xcframework ../../node_modules/expo-sqlite/ios/vec.xcframework 2>/dev/null || true",
        "ios": "EXPO_PUBLIC_AI_DISABLE=true APP_VARIANT=development expo run:ios",
        "ios:device": "EXPO_PUBLIC_AI_DISABLE=true APP_VARIANT=development expo run:ios --device",
        "lint": "oxlint --type-aware src && eslint src",
        "lint:eslint": "eslint src",
        "lint:fix": "oxlint --type-aware --fix src && eslint --fix src",
        "prebuild": "expo prebuild --clean",
        "prebuild:dev": "EXPO_PUBLIC_AI_DISABLE=true APP_VARIANT=development expo prebuild --clean",
        "start": "expo start --dev-client -c",
        "ts": "node ../../node_modules/@typescript/native/bin/tsc -p .",
        "web": "expo start --web"
    },
    "dependencies": {
        "@budgie/ai": "workspace:^",
        "@budgie/budget": "workspace:*",
        "@budgie/consolidation": "workspace:*",
        "@budgie/contracts": "workspace:^",
        "@budgie/logger": "workspace:*",
        "@budgie/sync": "workspace:*",
        "@expo/fingerprint": "~0.20.11",
        "@expo/ui": "~57.0.14",
        "@formatjs/intl": "^4.1.19",
        "@formatjs/intl-pluralrules": "^6.3.13",
        "@hookform/resolvers": "^5.9.1",
        "@legendapp/list": "^3.3.9",
        "@lingui/core": "6.5.0",
        "@lingui/react": "6.5.0",
        "@react-native-masked-view/masked-view": "^0.3.2",
        "@rnw-community/react-native-collapsible-header": "^2.15.1",
        "@rnw-community/react-native-screen-chrome": "^2.15.0",
        "@rnw-community/shared": "^2.2.0",
        "@vnaidin/react-native-cryptocurrency-icons": "0.0.36",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.3.0",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.45.2",
        "expo": "^57.0.18",
        "expo-asset": "~57.0.15",
        "expo-background-task": "~57.0.14",
        "expo-blur": "~57.0.2",
        "expo-build-properties": "~57.0.15",
        "expo-clipboard": "~57.0.1",
        "expo-constants": "~57.0.16",
        "expo-contacts": "~57.0.4",
        "expo-dev-client": "~57.0.16",
        "expo-document-picker": "~57.0.1",
        "expo-drizzle-studio-plugin": "^0.2.1",
        "expo-file-system": "~57.0.6",
        "expo-font": "~57.0.2",
        "expo-haptics": "~57.0.2",
        "expo-image": "~57.0.3",
        "expo-linear-gradient": "~57.0.1",
        "expo-linking": "~57.0.8",
