{
    "name": "@budgie/import-export",
    "version": "6.117.0",
    "private": true,
    "description": "CSV import and export of transactions",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/esm/index.d.ts",
            "default": "./dist/esm/index.js"
        },
        "./package.json": "./package.json"
    },
    "main": "./dist/esm/index.js",
    "types": "./dist/esm/index.d.ts",
    "scripts": {
        "build": "node ../../node_modules/@typescript/native/bin/tsc -p tsconfig.json",
        "build:watch": "pnpm build --watch",
        "clear": "rimraf dist node_modules/.cache .turbo",
        "format": "oxfmt --write src test",
        "lint": "oxlint --type-aware src",
        "lint:fix": "oxlint --type-aware --fix src",
        "test": "vitest run",
        "ts": "node ../../scripts/typecheck.cjs --noEmit -p tsconfig.json && node ../../scripts/typecheck.cjs --noEmit -p tsconfig.test.json",
        "ts:native": "node ../../scripts/typecheck.cjs --native --noEmit -p tsconfig.json && node ../../scripts/typecheck.cjs --native --noEmit -p tsconfig.test.json"
    },
    "dependencies": {
        "@budgie/contracts": "workspace:^",
        "@budgie/ledger": "workspace:*",
        "@rnw-community/shared": "^2.28.0",
        "date-fns": "^4.4.0",
        "effect": "4.0.6",
        "papaparse": "^5.7.0"
    },
    "devDependencies": {
        "@budgie-at/test-kit": "workspace:*",
        "@effect/vitest": "4.0.6",
        "@types/node": "26.6.5",
        "@types/papaparse": "^5",
        "vitest": "^5.0.5"
    }
}
