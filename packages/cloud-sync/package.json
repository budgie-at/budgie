{
    "name": "@budgie/cloud-sync",
    "version": "6.173.33",
    "private": true,
    "description": "Cloud sync package: record mapping, upload, apply, household sharing and the sync engine",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/esm/index.d.ts",
            "default": "./dist/esm/index.js"
        },
        "./package.json": "./package.json"
    },
    "main": "./dist/esm/index.js",
    "types": "./dist/esm/index.d.ts",
    "scripts": {
        "build": "node ../../node_modules/@typescript/native/bin/tsc -p tsconfig.json",
        "build:watch": "pnpm build --watch",
        "clear": "rimraf dist node_modules/.cache .turbo",
        "lint": "oxlint --type-aware src",
        "test": "vitest run",
        "ts": "node ../../scripts/typecheck.cjs --noEmit -p tsconfig.json && node ../../scripts/typecheck.cjs --noEmit -p tsconfig.test.json",
        "ts:native": "node ../../scripts/typecheck.cjs --native --noEmit -p tsconfig.json && node ../../scripts/typecheck.cjs --native --noEmit -p tsconfig.test.json"
    },
    "dependencies": {
        "@budgie/ai": "workspace:*",
        "@budgie/categorization": "workspace:*",
        "@budgie/consolidation": "workspace:*",
        "@budgie/contracts": "workspace:^",
        "@budgie/ledger": "workspace:*",
        "@budgie/recurring": "workspace:*",
        "@budgie/rules": "workspace:*",
        "@noble/hashes": "^2.4.0",
        "@rnw-community/shared": "^3.0.5",
        "drizzle-orm": "1.0.0-rc.4",
        "effect": "4.1.2"
    },
    "devDependencies": {
        "@budgie-at/test-kit": "workspace:*",
        "@effect/vitest": "4.1.2",
        "@types/node": "26.6.6",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "vitest": "5.1.0"
    }
}
