{
    "name": "@budgie/budget",
    "version": "5.36.2",
    "private": true,
    "description": "Budget domain services",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/esm/index.d.ts",
            "import": "./dist/esm/index.js",
            "react-native": "./dist/esm/index.js",
            "default": "./dist/esm/index.js"
        },
        "./package.json": "./package.json",
        "./query/budget-repository": {
            "types": "./dist/esm/query/repository/budget.repository.d.ts",
            "import": "./dist/esm/query/repository/budget.repository.js",
            "react-native": "./dist/esm/query/repository/budget.repository.js",
            "default": "./dist/esm/query/repository/budget.repository.js"
        },
        "./query/budget-category-limit-repository": {
            "types": "./dist/esm/query/repository/budget-category-limit.repository.d.ts",
            "import": "./dist/esm/query/repository/budget-category-limit.repository.js",
            "react-native": "./dist/esm/query/repository/budget-category-limit.repository.js",
            "default": "./dist/esm/query/repository/budget-category-limit.repository.js"
        }
    },
    "main": "./dist/esm/index.js",
    "react-native": "./dist/esm/index.js",
    "types": "./dist/esm/index.d.ts",
    "scripts": {
        "build": "run -T tsc -p tsconfig.json",
        "build:watch": "yarn build --watch",
        "clear": "yarn run -T rimraf dist node_modules/.cache .turbo",
        "format": "run -T prettier --write src",
        "lint": "run -T eslint --fix src",
        "ts": "run -T tsc -p ."
    },
    "dependencies": {
        "@budgie/contracts": "workspace:*",
        "@budgie/logger": "workspace:*",
        "@rnw-community/shared": "^2.2.0",
        "date-fns": "^4.3.0",
        "drizzle-orm": "^0.45.2"
    }
}
