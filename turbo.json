{
    "$schema": "https://turborepo.com/schema.json",
    "globalDependencies": [
        "tsconfig*.json",
        ".env*"
    ],
    "tasks": {
        "release": {
            "dependsOn": [
                "^release"
            ],
            "outputs": [
                "dist/**",
                "build/**"
            ]
        },
        "ts": {
            "dependsOn": [
                "^ts"
            ],
            "outputs": [
                "node_modules/.cache/tsbuildinfo.json",
                "dist/**"
            ]
        },
        "clear": {
            "outputs": []
        },
        "build": {
            "dependsOn": [
                "^build"
            ],
            "env": [
                "ADMIN_SECRET",
                "INDEXNOW_KEY",
                "KV_REST_API_READ_ONLY_TOKEN",
                "KV_REST_API_TOKEN",
                "KV_REST_API_URL",
                "KV_URL",
                "REDIS_URL"
            ],
            "outputs": [
                "dist/**",
                ".next/**"
            ]
        },
        "test": {
            "dependsOn": [
                "^build"
            ]
        },
        "//#cpd": {
            "outputs": [
                "report/jscpd/**"
            ]
        },
        "//#deadcode": {
            "outputs": []
        }
    },
    "agentGuidance": false
}
