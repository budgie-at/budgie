{
    "$schema": "https://turborepo.com/schema.json",
    "globalDependencies": ["tsconfig*.json", ".env*", "scripts/typecheck.cjs"],
    "tasks": {
        "release": {
            "dependsOn": ["^release"],
            "outputs": ["dist/**", "build/**"]
        },
        "ts": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/app/src/**", "$TURBO_ROOT$/packages/app/drizzle/**"],
            "outputs": []
        },
        "@budgie/categorization#ts": {
            "dependsOn": ["^build", "build"],
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/app/src/**", "$TURBO_ROOT$/packages/app/drizzle/**"],
            "outputs": []
        },
        "@budgie/rules#ts": {
            "dependsOn": ["^build", "build"],
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/app/src/**", "$TURBO_ROOT$/packages/app/drizzle/**"],
            "outputs": []
        },
        "ts:native": {
            "dependsOn": ["^build"],
            "outputs": ["node_modules/.cache/typecheck-native-*.json"]
        },
        "clear": {
            "outputs": []
        },
        "build": {
            "dependsOn": ["^build"],
            "env": [
                "ADMIN_SECRET",
                "INDEXNOW_KEY",
                "KV_REST_API_READ_ONLY_TOKEN",
                "KV_REST_API_TOKEN",
                "KV_REST_API_URL",
                "KV_URL",
                "REDIS_URL"
            ],
            "outputs": ["dist/**", ".next/**", "node_modules/.cache/tsbuildinfo.json"]
        },
        "test": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/app/src/**", "$TURBO_ROOT$/packages/app/drizzle/**"]
        },
        "@budgie/categorization#test": {
            "dependsOn": ["^build", "build"],
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/app/src/**", "$TURBO_ROOT$/packages/app/drizzle/**"]
        },
        "@budgie/rules#test": {
            "dependsOn": ["^build", "build"],
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/app/src/**", "$TURBO_ROOT$/packages/app/drizzle/**"]
        }
    },
    "agentGuidance": false
}
