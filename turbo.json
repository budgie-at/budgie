{
    "$schema": "https://turborepo.com/schema.json",
    "globalDependencies": ["tsconfig*.json", ".env*", "scripts/typecheck.cjs"],
    "tasks": {
        "release": {
            "dependsOn": ["^release"],
            "outputs": ["dist/**", "build/**"]
        },
        "ts": {
            "dependsOn": ["^build"],
            "outputs": []
        },
        "@budgie/categorization#ts": {
            "dependsOn": ["^build", "build"],
            "outputs": []
        },
        "@budgie/rules#ts": {
            "dependsOn": ["^build", "build"],
            "outputs": []
        },
        "ts:native": {
            "dependsOn": ["^build"],
            "outputs": ["node_modules/.cache/typecheck-native-*.json"]
        },
        "@budgie-at/sync-tests#ts": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/app/src/**"],
            "outputs": []
        },
        "@budgie-at/consolidation-tests#ts": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/app/src/**"],
            "outputs": []
        },
        "@budgie-at/budget-tests#ts": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/app/src/**"],
            "outputs": []
        },
        "@budgie-at/test-kit#ts": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/app/src/**"],
            "outputs": []
        },
        "clear": {
            "outputs": []
        },
        "build": {
            "dependsOn": ["^build"],
            "env": [
                "ADMIN_SECRET",
                "INDEXNOW_KEY",
                "KV_REST_API_READ_ONLY_TOKEN",
                "KV_REST_API_TOKEN",
                "KV_REST_API_URL",
                "KV_URL",
                "REDIS_URL"
            ],
            "outputs": ["dist/**", ".next/**", "node_modules/.cache/tsbuildinfo.json"]
        },
        "test": {
            "dependsOn": ["^build"]
        },
        "@budgie/categorization#test": {
            "dependsOn": ["^build", "build"],
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/app/src/**"]
        },
        "@budgie/rules#test": {
            "dependsOn": ["^build", "build"],
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/app/src/**"]
        },
        "@budgie/cloud-sync#test": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/app/src/**"]
        },
        "@budgie/import-export#test": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/app/src/**"]
        },
        "@budgie/ledger#test": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/app/src/**"]
        },
        "@budgie/market#test": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/app/src/**"]
        },
        "@budgie/recurring#test": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/app/src/**"]
        },
        "@budgie-at/sync-tests#test": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/app/src/**"]
        },
        "@budgie-at/consolidation-tests#test": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/app/src/**"]
        },
        "@budgie-at/budget-tests#test": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/app/src/**"]
        },
        "lint": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxlintrc.json", "$TURBO_ROOT$/lint-rules/**"],
            "outputs": []
        },
        "//#lint:rules": {
            "inputs": ["lint-rules/**", ".oxlintrc.json", "package.json"],
            "outputs": []
        },
        "//#deadcode:run": {
            "inputs": [
                "knip.json",
                "package.json",
                "pnpm-workspace.yaml",
                "tsconfig*.json",
                "packages/**",
                "tests/**",
                "e2e/**",
                "scripts/**",
                "lint-rules/**",
                "!**/.next/**",
                "!**/.turbo/**",
                "!**/.expo/**",
                "!**/dist/**",
                "!**/node_modules/**",
                "!**/coverage/**",
                "!**/report/**"
            ],
            "outputs": []
        }
    },
    "agentGuidance": false
}
