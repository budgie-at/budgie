{
    "ios-target": {
        "name": "e2e",
        "appDir": "packages/app",
        "workspace": "budgieE2E.xcworkspace",
        "scheme": "budgieE2E",
        "appId": "com.vitalyiegorov.budgie.e2e",
        "prebuildCommand": "npx expo prebuild -p ios --clean --no-install"
    },
    "capture-mode": "direct",
    "capture-manifest": [
        {
            "platform": "ios",
            "device": "iPhone 17 Pro Max",
            "locales": ["en", "fr", "uk", "de", "es"],
            "appearances": ["light", "dark"]
        },
        {
            "platform": "ios",
            "device": "iPad Pro 13-inch (M4)",
            "locales": ["en", "fr", "uk", "de", "es"],
            "appearances": ["light", "dark"]
        }
    ],
    "capture-scenes": [
        { "name": "00-prime", "flow": "flows/setup/prime-deep-links-scene.flow.yaml" },

        { "name": "home-hero-1", "deepLink": "budgie://" },
        { "name": "home-hero-2", "deepLink": "budgie://budget" },

        { "name": "voice-transaction-entry-1", "flow": "flows/media/voice-listening.flow.yaml" },
        { "name": "voice-transaction-entry-2", "flow": "flows/media/voice-review.flow.yaml" },
        { "name": "ai-auto-categorization-1", "flow": "flows/media/ai-suggestion-pills.flow.yaml" },
        { "name": "ai-auto-categorization-2", "deepLink": "budgie://settings?anchor=ai" },
        { "name": "on-device-ai-budget-app-1", "deepLink": "budgie://settings?anchor=ai" },
        { "name": "monobank-sync-1", "deepLink": "budgie://bank-integration/1" },
        { "name": "monobank-sync-2", "deepLink": "budgie://" },
        { "name": "net-worth-tracker-1", "deepLink": "budgie://" },
        { "name": "offline-first-expense-tracker-1", "deepLink": "budgie://transactions" },
        { "name": "offline-first-expense-tracker-2", "deepLink": "budgie://settings?anchor=general" },
        { "name": "private-budget-app-alternative-1", "deepLink": "budgie://settings" },
        { "name": "subscription-free-budget-app-1", "deepLink": "budgie://settings" },

        { "name": "expense-tracking-1", "deepLink": "budgie://create-transaction/expense" },
        { "name": "expense-tracking-2", "deepLink": "budgie://transactions" },
        { "name": "account-management-1", "deepLink": "budgie://" },
        { "name": "account-management-2", "deepLink": "budgie://settings/archived" },
        { "name": "account-transfers-1", "flow": "flows/media/cross-currency-transfer.flow.yaml" },
        { "name": "ai-transaction-suggestions-1", "flow": "flows/media/ai-history-suggestions.flow.yaml" },
        { "name": "biometric-authentication-1", "deepLink": "budgie://settings/pin?mode=CHANGE" },
        { "name": "csv-import-1", "deepLink": "budgie://settings/import" },
        { "name": "csv-import-2", "flow": "flows/media/csv-column-mapper.flow.yaml" },
        { "name": "custom-categories-1", "deepLink": "budgie://settings/categories" },
        { "name": "custom-categories-2", "flow": "flows/media/category-form.flow.yaml" },
        { "name": "database-backup-1", "deepLink": "budgie://settings?anchor=data" },
        { "name": "data-export-1", "flow": "flows/media/export-share.flow.yaml" },
        { "name": "date-filter-presets-1", "flow": "flows/media/date-filter.flow.yaml" },
        { "name": "erste-bank-pdf-import-1", "flow": "flows/media/erste-pdf-preview.flow.yaml" },
        { "name": "no-bank-login-budget-app-1", "flow": "flows/media/bank-token-entry.flow.yaml" },
        { "name": "open-source-budget-app-mobile-1", "deepLink": "budgie://settings" },
        { "name": "pin-app-lock-1", "flow": "flows/media/pin-locked-cold-open.flow.yaml" },
        { "name": "pin-app-lock-2", "deepLink": "budgie://settings?anchor=security" },
        { "name": "privatbank-import-1", "flow": "flows/media/privatbank-xlsx-preview.flow.yaml" },
        { "name": "spending-analytics-1", "deepLink": "budgie://analytics" },
        { "name": "spending-analytics-2", "flow": "flows/media/analytics-drilldown.flow.yaml" },
        { "name": "transaction-long-press-menu-1", "flow": "flows/media/long-press-menu.flow.yaml" },
        { "name": "transaction-tags-1", "flow": "flows/media/tags-selector-open.flow.yaml" },
        { "name": "transaction-tags-2", "deepLink": "budgie://transactions" },
        { "name": "uncategorized-transactions-1", "flow": "flows/media/uncategorized-pill.flow.yaml" },
        { "name": "uncategorized-transactions-2", "flow": "flows/media/uncategorized-cleanup-page.flow.yaml" },

        { "name": "multi-currency-1", "flow": "flows/media/net-worth-drilldown.flow.yaml" },
        { "name": "multi-currency-2", "deepLink": "budgie://currency/1" },
        { "name": "debt-tracking-1", "deepLink": "budgie://" },
        { "name": "debt-tracking-2", "deepLink": "budgie://account/7/details" },
        { "name": "deposit-tracking-1", "deepLink": "budgie://account/8/details" },
        { "name": "recurring-payments-calendar-1", "flow": "flows/media/transactions-recurring-tab.flow.yaml" },
        { "name": "recurring-payments-calendar-2", "flow": "flows/media/recurring-day-detail.flow.yaml" },
        { "name": "split-transactions-1", "flow": "flows/media/split-entries.flow.yaml" },
        { "name": "statistics-tags-tab-1", "flow": "flows/media/analytics-tags-tab.flow.yaml" },
        { "name": "tag-analytics-1", "flow": "flows/media/analytics-untagged-drilldown.flow.yaml" },
        { "name": "transfer-pair-detection-1", "deepLink": "budgie://transactions" },
        { "name": "transfer-pair-detection-2", "flow": "flows/media/consolidation-review.flow.yaml" },
        { "name": "convert-to-transfer-1", "flow": "flows/media/convert-to-transfer-picker.flow.yaml" },
        { "name": "bank-resync-window-1", "flow": "flows/media/resync-window-picker.flow.yaml" },
        { "name": "bank-fee-tracking-1", "flow": "flows/media/transaction-fee-sheet.flow.yaml" },
        { "name": "bank-fee-tracking-2", "deepLink": "budgie://analytics" },
        { "name": "mcc-auto-category-1", "deepLink": "budgie://transactions/9001/expense/edit" },
        { "name": "ai-tag-suggestions-1", "flow": "flows/media/ai-tag-pills.flow.yaml" },
        { "name": "ai-merchant-translation-1", "flow": "flows/media/category-form-translation.flow.yaml" },

        { "name": "crypto-investment-tracking-1", "deepLink": "budgie://" },
        { "name": "crypto-investment-tracking-2", "deepLink": "budgie://account/9/details" },
        { "name": "convert-to-refund-1", "flow": "flows/media/convert-to-refund-picker.flow.yaml" },
        { "name": "primary-tag-1", "deepLink": "budgie://transactions" },
        { "name": "multi-language-app-1", "flow": "flows/media/language-selector.flow.yaml" },
        { "name": "screenshot-protection-1", "deepLink": "budgie://settings?anchor=security" }
    ],
    "screenshots-dir": "tests/app-tests",
    "maestro-config": "tests/app-tests/config.yaml",
    "seed-command": "bash tests/app-tests/scripts/seed-screenshot-scene.sh",
    "settle-seconds": 6,
    "status-bar-override": true,
    "build-env": "APP_VARIANT=e2e\nEXPO_PUBLIC_AI_DISABLE=true\nEXPO_PUBLIC_LOGGING_DISABLE=true\n",
    "install-command": "pnpm install --frozen-lockfile",
    "cache-profile": "ios-e2e-budgie-v2",
    "rct-use-prebuilt-rncore": true,
    "rct-use-rn-dep": true,
    "repack-on-hit": true,
    "screenshots-download-dir": "fastlane/screenshots/landing-raw"
}
