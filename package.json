{
    "name": "@budgie-at/root",
    "version": "1.18.1",
    "private": true,
    "description": "suudokuuu platform",
    "license": "SEE LICENSE IN LICENSE",
    "author": "Vitalii Yehorov",
    "scripts": {
        "build": "turbo run build",
        "build:force": "turbo run build --force",
        "clear": "turbo run clear",
        "cpd": "jscpd . --pattern \"**/*.{ts,tsx}\"",
        "deadcode": "KNIP_DISABLE_RAW_TRANSFER=1 knip",
        "deps:check": "pnpm dlx check-dependency-version-consistency .",
        "deps:dedupe": "pnpm dedupe",
        "deps:update": "pnpm dlx npm-check-updates",
        "format": "oxfmt --write \"**/*.{ts,tsx}\" packages/app/expo-env.d.ts",
        "format:check": "oxfmt --check \"**/*.{ts,tsx}\" packages/app/expo-env.d.ts",
        "i18n:check": "pnpm i18n:sync && git diff --name-only --exit-code HEAD -- packages/app/src/i18n/locales packages/landing/src/i18n/locales",
        "i18n:sync": "pnpm --filter @budgie-at/app i18n:sync && pnpm --filter @budgie-at/landing i18n:sync",
        "lint": "effect-tsgo --tsrs-lint oxlint --type-aware packages/app/src packages/landing packages/ai/src packages/budget/src packages/market/src packages/ledger/src packages/rules/src packages/recurring/src packages/categorization/src packages/import-export/src packages/sync/src packages/consolidation/src packages/amount-input/src packages/contracts/src packages/*/test tests/budget-tests/src tests/consolidation-tests/src tests/sync-tests/src tests/test-kit/src lint-rules",
        "lint:fix": "pnpm lint --fix",
        "media:capture": "bash tests/app-tests/scripts/capture-store-screenshots.sh --config .github/landing-media.config.json --output packages/app/fastlane/screenshots/landing-raw",
        "media:compose": "bash packages/app/fastlane/screenshots/design/compose-web-media.sh",
        "media:manifest": "pnpm --filter @budgie-at/landing media:manifest",
        "postinstall": "node ./scripts/after-install.cjs",
        "release": "lerna publish --yes --conventional-commits --create-release=github -m \"chore: release %s [skip ci]\"",
        "test": "turbo run test",
        "test:lint": "node --test lint-rules/rules/*.test.mjs",
        "ts": "turbo run ts",
        "ts:native": "turbo run ts:native",
        "verify:backup": "sh -c 'set -e; test -f \"$1\"; mkdir -p \"$HOME/.cache\" && BUDGIE_BACKUP_DB=\"$(realpath \"$1\")\" TMPDIR=\"$HOME/.cache\" pnpm --filter @budgie-at/sync-tests exec vitest run src/scenarios/database/backup-replay.test.ts' verify-backup"
    },
    "devDependencies": {
        "@commitlint/cli": "21.2.4",
        "@commitlint/config-conventional": "21.2.4",
        "@commitlint/config-lerna-scopes": "21.2.0",
        "@effect/tsgo": "0.67.1",
        "@lingui/cli": "6.12.0",
        "@oxlint/migrate": "1.90.0",
        "@react-native/eslint-plugin": "0.88.1",
        "@rnw-community/eslint-plugin": "2.29.0",
        "@stylistic/eslint-plugin": "5.10.0",
        "@types/node": "26.6.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@typescript/native": "npm:typescript@7.0.2",
        "eslint-plugin-lingui": "0.16.0",
        "eslint-plugin-n": "18.5.0",
        "eslint-plugin-react-native": "5.0.0",
        "husky": "9.1.7",
        "jscpd": "5.4.2",
        "knip": "6.44.1",
        "lerna": "10.1.1",
        "lint-staged": "17.6.0",
        "oxfmt": "0.76.0",
        "oxlint": "1.91.0",
        "rimraf": "6.1.3",
        "sort-package-json": "4.1.0",
        "tsrs": "0.21.0-ts7.1.0-beta",
        "turbo": "2.11.10",
        "typescript": "npm:@typescript/typescript6@6.0.2"
    },
    "packageManager": "pnpm@12.16.1",
    "engines": {
        "node": ">=22.22.2"
    },
    "op-sqlite": {
        "sqlcipher": true,
        "sqliteVec": true,
        "fts5": true
    }
}
