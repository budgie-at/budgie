{
    "name": "@budgie-at/root",
    "version": "1.18.1",
    "private": true,
    "description": "suudokuuu platform",
    "license": "SEE LICENSE IN LICENSE",
    "author": "Vitalii Yehorov",
    "workspaces": [
        "packages/*",
        "utils/*",
        "tests/*"
    ],
    "scripts": {
        "build": "turbo run build",
        "build:force": "turbo run build --force",
        "cpd": "jscpd --pattern \"**/*.{ts,tsx}\"",
        "deps:check": "yarn dlx check-dependency-version-consistency .",
        "deps:dedupe": "yarn dedupe",
        "deps:update": "yarn dlx npm-check-updates",
        "deadcode": "knip",
        "security": "rnsec scan",
        "format": "prettier --write \"**/*.{ts,tsx}\"",
        "clear": "turbo run clear",
        "lint": "turbo run lint",
        "lint:force": "turbo run lint --force",
        "release": "lerna publish --yes --conventional-commits --create-release=github -m \"chore: release %s [skip ci]\"",
        "test": "turbo run test",
        "test:coverage": "turbo run test:coverage",
        "ts": "turbo run ts",
        "ts:force": "turbo run ts --force"
    },
    "resolutions": {
        "typescript": "^5.9.3",
        "react": "19.2.0",
        "react-dom": "19.2.0",
        "@lingui/core": "5.7.0",
        "@lingui/react": "5.7.0",
        "lightningcss": "1.30.1",
        "hermes-compiler": "250829098.0.4"
    },
    "devDependencies": {
        "@commitlint/cli": "^19.8.1",
        "@commitlint/config-conventional": "^19.8.1",
        "@commitlint/config-lerna-scopes": "^19.8.1",
        "@eslint/js": "^9.39.1",
        "@jest/globals": "^29.5.0",
        "@lingui/cli": "^5.5.2",
        "@rnw-community/eslint-plugin": "^1.8.2",
        "@types/node": "^24.5.2",
        "@types/react": "^19.1.17",
        "@types/react-dom": "^19.1.17",
        "babel-jest": "^30.2.0",
        "eslint": "^9.38.0",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jest": "^29.0.1",
        "eslint-plugin-lingui": "^0.11.0",
        "eslint-plugin-n": "^17.23.1",
        "eslint-plugin-promise": "^7.2.1",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "husky": "^9.1.7",
        "jest": "~29.7.0",
        "jscpd": "^4.0.5",
        "knip": "^5.62.0",
        "lerna": "^8.2.3",
        "lint-staged": "^16.1.2",
        "prettier": "^3.6.2",
        "rimraf": "^6.0.1",
        "rnsec": "^1.0.1",
        "sort-package-json": "^3.4.0",
        "turbo": "^2.7.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.46.3"
    },
    "packageManager": "yarn@4.12.0",
    "engines": {
        "node": ">=22.0.0"
    }
}
