{
    "name": "@budgie-at/root",
    "version": "1.18.1",
    "private": true,
    "description": "suudokuuu platform",
    "license": "SEE LICENSE IN LICENSE",
    "author": "Vitalii Yehorov",
    "workspaces": [
        "packages/*",
        "utils/*",
        "tests/*"
    ],
    "scripts": {
        "build": "turbo run build",
        "build:force": "turbo run build --force",
        "clear": "turbo run clear",
        "cpd": "jscpd . --pattern \"**/*.{ts,tsx}\"",
        "deadcode": "KNIP_DISABLE_RAW_TRANSFER=1 knip",
        "deps:check": "yarn dlx check-dependency-version-consistency .",
        "deps:dedupe": "yarn dedupe",
        "deps:update": "yarn dlx npm-check-updates",
        "format": "oxfmt --write \"**/*.{ts,tsx}\" packages/app/expo-env.d.ts packages/app/nativewind-env.d.ts",
        "format:check": "oxfmt --check \"**/*.{ts,tsx}\" packages/app/expo-env.d.ts packages/app/nativewind-env.d.ts",
        "i18n:check": "yarn i18n:sync && git diff --name-only --exit-code HEAD -- packages/app/src/i18n/locales packages/landing/src/i18n/locales",
        "i18n:sync": "yarn workspace @budgie-at/app i18n:sync && yarn workspace @budgie-at/landing i18n:sync",
        "lint": "yarn lint:oxlint && yarn lint:eslint",
        "lint:eslint": "eslint packages/app/src packages/landing packages/ai/src packages/budget/src packages/logger/src packages/bank-sync/src packages/consolidation/src packages/contracts/src",
        "lint:fix": "oxlint --type-aware --fix packages/app/src packages/landing packages/ai/src packages/budget/src packages/logger/src packages/bank-sync/src packages/consolidation/src packages/contracts/src && eslint --fix packages/app/src packages/landing packages/ai/src packages/budget/src packages/logger/src packages/bank-sync/src packages/consolidation/src packages/contracts/src",
        "lint:oxlint": "oxlint --type-aware packages/app/src packages/landing packages/ai/src packages/budget/src packages/logger/src packages/bank-sync/src packages/consolidation/src packages/contracts/src",
        "release": "lerna publish --yes --conventional-commits --create-release=github -m \"chore: release %s [skip ci]\"",
        "security": "rnsec scan",
        "test": "turbo run test",
        "test:coverage": "turbo run test:coverage",
        "ts": "turbo run ts",
        "ts:force": "turbo run ts --force"
    },
    "resolutions": {
        "@lingui/core": "6.5.0",
        "@lingui/react": "6.5.0",
        "@typescript/old@npm:typescript@^6": "npm:typescript@6.0.2",
        "@ungap/structured-clone": "1.3.1",
        "@xmldom/xmldom": "0.8.13",
        "ajv@npm:^8.11.0": "8.20.0",
        "brace-expansion@npm:^1.1.7": "1.1.13",
        "brace-expansion@npm:^2.0.1": "2.0.3",
        "fast-uri": "3.1.2",
        "flatted": "3.4.2",
        "handlebars": "4.7.9",
        "hermes-compiler": "250829098.0.4",
        "ip-address": "10.2.0",
        "lightningcss": "1.30.1",
        "lodash": "4.18.1",
        "minimatch@npm:^9.0.4": "9.0.7",
        "node-forge": "1.4.0",
        "node-gyp@npm:latest": "12.3.0",
        "picomatch@npm:^2.0.4": "2.3.2",
        "picomatch@npm:^2.2.3": "2.3.2",
        "picomatch@npm:^2.3.1": "2.3.2",
        "postcss@npm:8.4.31": "8.5.15",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "ws@npm:^8.12.1": "8.21.0"
    },
    "devDependencies": {
        "@commitlint/cli": "21.2.1",
        "@commitlint/config-conventional": "21.2.0",
        "@commitlint/config-lerna-scopes": "21.2.0",
        "@eslint/compat": "2.1.0",
        "@eslint/js": "10.0.1",
        "@jest/globals": "30.4.1",
        "@lingui/cli": "6.5.0",
        "@oxlint/migrate": "1.73.0",
        "@rnw-community/eslint-plugin": "2.0.0",
        "@stylistic/eslint-plugin": "5.10.0",
        "@types/node": "22.20.1",
        "@types/react": "19.2.17",
        "@types/react-dom": "19.2.3",
        "@typescript/native": "npm:typescript@7.0.2",
        "eslint": "10.7.0",
        "eslint-plugin-import": "2.32.0",
        "eslint-plugin-jest": "29.15.4",
        "eslint-plugin-lingui": "0.14.0",
        "eslint-plugin-n": "18.2.2",
        "eslint-plugin-oxlint": "1.73.0",
        "eslint-plugin-promise": "7.3.0",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hooks": "7.1.1",
        "husky": "9.1.7",
        "jest": "30.4.2",
        "jscpd": "5.0.12",
        "knip": "6.26.0",
        "lerna": "9.0.7",
        "lint-staged": "17.0.8",
        "oxfmt": "0.58.0",
        "oxlint": "1.73.0",
        "oxlint-tsgolint": "0.24.0",
        "rimraf": "6.1.3",
        "rnsec": "1.3.0",
        "sort-package-json": "4.0.0",
        "turbo": "2.10.4",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "typescript-eslint": "8.63.0"
    },
    "dependenciesMeta": {
        "better-sqlite3@12.10.0": {
            "built": true
        },
        "llama.rn@0.12.4": {
            "built": true
        }
    },
    "packageManager": "yarn@4.17.1",
    "engines": {
        "node": ">=22.22.1"
    }
}
