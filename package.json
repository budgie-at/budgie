{
    "name": "@budgie-at/root",
    "version": "1.18.1",
    "private": true,
    "description": "suudokuuu platform",
    "license": "SEE LICENSE IN LICENSE",
    "author": "Vitalii Yehorov",
    "scripts": {
        "build": "turbo run build",
        "build:force": "turbo run build --force",
        "clear": "turbo run clear",
        "cpd": "jscpd . --pattern \"**/*.{ts,tsx}\"",
        "deadcode": "KNIP_DISABLE_RAW_TRANSFER=1 knip",
        "deps:check": "pnpm dlx check-dependency-version-consistency .",
        "deps:dedupe": "pnpm dedupe",
        "deps:update": "pnpm dlx npm-check-updates",
        "format": "oxfmt --write \"**/*.{ts,tsx}\" packages/app/expo-env.d.ts packages/app/nativewind-env.d.ts",
        "format:check": "oxfmt --check \"**/*.{ts,tsx}\" packages/app/expo-env.d.ts packages/app/nativewind-env.d.ts",
        "i18n:check": "pnpm i18n:sync && git diff --name-only --exit-code HEAD -- packages/app/src/i18n/locales packages/landing/src/i18n/locales",
        "i18n:sync": "pnpm --filter @budgie-at/app i18n:sync && pnpm --filter @budgie-at/landing i18n:sync",
        "lint": "pnpm lint:oxlint && pnpm lint:eslint",
        "lint:eslint": "eslint packages/app/src packages/landing packages/ai/src packages/budget/src packages/logger/src packages/sync/src packages/consolidation/src packages/contracts/src",
        "lint:fix": "oxlint --type-aware --fix packages/app/src packages/landing packages/ai/src packages/budget/src packages/logger/src packages/sync/src packages/consolidation/src packages/contracts/src && eslint --fix packages/app/src packages/landing packages/ai/src packages/budget/src packages/logger/src packages/sync/src packages/consolidation/src packages/contracts/src",
        "lint:oxlint": "oxlint --type-aware packages/app/src packages/landing packages/ai/src packages/budget/src packages/logger/src packages/sync/src packages/consolidation/src packages/contracts/src",
        "media:capture": "bash tests/app-tests/scripts/capture-store-screenshots.sh --config .github/landing-media.config.json --output packages/app/fastlane/screenshots/landing-raw",
        "media:compose": "bash packages/app/fastlane/screenshots/design/compose-web-media.sh && bash packages/app/fastlane/screenshots/design/compose-web-clips.sh",
        "media:manifest": "pnpm --filter @budgie-at/landing media:manifest",
        "release": "lerna publish --yes --conventional-commits --create-release=github -m \"chore: release %s [skip ci]\"",
        "security": "rnsec scan",
        "test": "turbo run test",
        "test:coverage": "turbo run test:coverage",
        "ts": "turbo run ts",
        "ts:force": "turbo run ts --force"
    },
    "devDependencies": {
        "@commitlint/cli": "21.2.2",
        "@commitlint/config-conventional": "21.2.2",
        "@commitlint/config-lerna-scopes": "21.2.0",
        "@eslint/compat": "2.1.0",
        "@eslint/js": "10.0.1",
        "@jest/globals": "30.4.1",
        "@lingui/cli": "6.5.0",
        "@oxlint/migrate": "1.80.0",
        "@rnw-community/eslint-plugin": "2.0.0",
        "@stylistic/eslint-plugin": "5.10.0",
        "@types/node": "22.20.1",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.5",
        "@typescript/native": "npm:typescript@7.0.2",
        "eslint": "10.9.1",
        "eslint-plugin-import": "2.32.0",
        "eslint-plugin-jest": "29.16.5",
        "eslint-plugin-lingui": "0.14.0",
        "eslint-plugin-n": "18.3.0",
        "eslint-plugin-oxlint": "1.80.0",
        "eslint-plugin-promise": "7.3.0",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hooks": "7.1.1",
        "husky": "9.1.7",
        "jest": "30.5.0",
        "jscpd": "5.0.16",
        "knip": "6.33.0",
        "lerna": "9.0.7",
        "lint-staged": "17.4.1",
        "oxfmt": "0.65.0",
        "oxlint": "1.80.0",
        "oxlint-tsgolint": "0.25.0",
        "rimraf": "6.1.3",
        "rnsec": "1.3.0",
        "sort-package-json": "4.0.0",
        "turbo": "2.10.12",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "typescript-eslint": "8.68.0"
    },
    "packageManager": "pnpm@11.24.0",
    "engines": {
        "node": ">=22.22.1"
    },
    "postinstall": "node ./scripts/after-install.cjs"
}
