{
    "name": "@budgie-at/root",
    "version": "1.18.1",
    "private": true,
    "description": "suudokuuu platform",
    "license": "SEE LICENSE IN LICENSE",
    "author": "Vitalii Yehorov",
    "workspaces": [
        "packages/*",
        "utils/*",
        "tests/*"
    ],
    "scripts": {
        "build": "turbo run build",
        "build:force": "turbo run build --force",
        "clear": "turbo run clear",
        "cpd": "jscpd . --pattern \"**/*.{ts,tsx}\"",
        "deadcode": "knip",
        "deps:check": "yarn dlx check-dependency-version-consistency .",
        "deps:dedupe": "yarn dedupe",
        "deps:update": "yarn dlx npm-check-updates",
        "format": "prettier --write \"**/*.{ts,tsx}\"",
        "i18n:check": "yarn i18n:sync && git diff --name-only --exit-code HEAD -- packages/app/src/i18n/locales packages/landing/src/i18n/locales",
        "i18n:sync": "yarn workspace @budgie-at/app i18n:sync && yarn workspace @budgie-at/landing i18n:sync",
        "lint": "turbo run lint",
        "lint:force": "turbo run lint --force",
        "release": "lerna publish --yes --conventional-commits --create-release=github -m \"chore: release %s [skip ci]\"",
        "security": "rnsec scan",
        "test": "turbo run test",
        "test:coverage": "turbo run test:coverage",
        "ts": "turbo run ts",
        "ts:force": "turbo run ts --force"
    },
    "resolutions": {
        "@lingui/core": "6.1.0",
        "@lingui/react": "6.1.0",
        "@typescript/old@npm:typescript@^6": "npm:typescript@6.0.2",
        "@ungap/structured-clone": "1.3.1",
        "@xmldom/xmldom": "0.8.13",
        "ajv@npm:^8.11.0": "8.20.0",
        "brace-expansion@npm:^1.1.7": "1.1.13",
        "brace-expansion@npm:^2.0.1": "2.0.3",
        "fast-uri": "3.1.2",
        "flatted": "3.4.2",
        "handlebars": "4.7.9",
        "hermes-compiler": "250829098.0.4",
        "ip-address": "10.2.0",
        "lightningcss": "1.30.1",
        "lodash": "4.18.1",
        "minimatch@npm:^9.0.4": "9.0.7",
        "node-forge": "1.4.0",
        "node-gyp@npm:latest": "12.3.0",
        "picomatch@npm:^2.0.4": "2.3.2",
        "picomatch@npm:^2.2.3": "2.3.2",
        "picomatch@npm:^2.3.1": "2.3.2",
        "postcss@npm:8.4.31": "8.5.15",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "ws@npm:^8.12.1": "8.21.0"
    },
    "devDependencies": {
        "@commitlint/cli": "21.2.1",
        "@commitlint/config-conventional": "21.2.0",
        "@commitlint/config-lerna-scopes": "21.2.0",
        "@eslint/js": "^9.39.1",
        "@jest/globals": "^29.5.0",
        "@lingui/cli": "6.1.0",
        "@rnw-community/eslint-plugin": "2.0.0",
        "@stylistic/eslint-plugin": "5.10.0",
        "@types/node": "22.20.1",
        "@types/react": "19.2.17",
        "@types/react-dom": "19.2.3",
        "@typescript/native": "npm:typescript@7.0.2",
        "babel-jest": "^30.2.0",
        "eslint": "^9.38.0",
        "eslint-plugin-import": "2.32.0",
        "eslint-plugin-jest": "^29.0.1",
        "eslint-plugin-lingui": "^0.13.1",
        "eslint-plugin-n": "^17.23.1",
        "eslint-plugin-promise": "7.3.0",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "husky": "^9.1.7",
        "jest": "~29.7.0",
        "jscpd": "5.0.12",
        "knip": "6.26.0",
        "lerna": "9.0.7",
        "lint-staged": "17.0.8",
        "prettier": "^3.8.3",
        "rimraf": "6.1.3",
        "rnsec": "1.3.0",
        "sort-package-json": "4.0.0",
        "turbo": "2.10.4",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "typescript-eslint": "^8.60.0"
    },
    "packageManager": "yarn@4.17.1",
    "engines": {
        "node": ">=22.22.1"
    }
}
