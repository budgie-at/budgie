{
    "ios-target": {
        "name": "e2e",
        "appDir": "packages/app",
        "workspace": "budgieE2E.xcworkspace",
        "scheme": "budgieE2E",
        "appId": "com.vitalyiegorov.budgie.e2e",
        "prebuildCommand": "npx expo prebuild -p ios --clean --no-install"
    },
    "capture-mode": "direct",
    "capture-manifest": [
        {
            "platform": "ios",
            "device": "iPhone 17 Pro",
            "locales": ["en"],
            "appearances": ["dark", "light"]
        }
    ],
    "capture-scenes": [
        {
            "name": "00-prime",
            "flow": "flows/setup/prime-deep-links-scene.flow.yaml"
        },
        {
            "name": "social-showcase-1",
            "deepLink": "budgie://"
        },
        {
            "name": "social-showcase-2",
            "deepLink": "budgie://transactions"
        },
        {
            "name": "social-showcase-3",
            "deepLink": "budgie://analytics"
        },
        {
            "name": "social-showcase-4",
            "deepLink": "budgie://create-transaction/expense"
        },
        {
            "name": "social-showcase-5",
            "deepLink": "budgie://budget"
        },
        {
            "name": "social-showcase-6",
            "deepLink": "budgie://settings?anchor=security"
        },
        {
            "name": "social-showcase-7",
            "deepLink": "budgie://settings?anchor=ai"
        },
        {
            "name": "social-showcase-8",
            "deepLink": "budgie://settings?anchor=data"
        },
        {
            "name": "social-showcase-9",
            "deepLink": "budgie://settings/import"
        },
        {
            "name": "social-showcase-10",
            "deepLink": "budgie://bank-integration/1"
        },
        {
            "name": "social-showcase-11",
            "deepLink": "budgie://account/9/details"
        },
        {
            "name": "social-showcase-12",
            "deepLink": "budgie://account/7/details"
        },
        {
            "name": "social-showcase-13",
            "deepLink": "budgie://account/8/details"
        },
        {
            "name": "social-showcase-14",
            "flow": "flows/media/social-accounts-scrolled.flow.yaml"
        },
        {
            "name": "social-showcase-15",
            "flow": "flows/media/social-voice-entry.flow.yaml"
        },
        {
            "name": "social-showcase-16",
            "flow": "flows/media/social-ai-suggestion.flow.yaml"
        },
        {
            "name": "social-showcase-17",
            "deepLink": "budgie://currency/1"
        },
        {
            "name": "social-showcase-18",
            "deepLink": "budgie://settings/categories"
        },
        {
            "name": "social-showcase-19",
            "deepLink": "budgie://settings/rules"
        },
        {
            "name": "social-lock-1",
            "flow": "flows/media/pin-app-lock-1.flow.yaml"
        },
        {
            "name": "social-lock-2",
            "deepLink": "budgie://settings?anchor=security"
        }
    ],
    "screenshots-dir": "tests/app-tests",
    "maestro-config": "tests/app-tests/config.yaml",
    "seed-command": "bash tests/app-tests/scripts/seed-screenshot-scene.sh",
    "settle-seconds": 6,
    "status-bar-override": true,
    "build-env": "APP_VARIANT=e2e\nEXPO_PUBLIC_AI_DISABLE=true\nEXPO_PUBLIC_LOGGING_DISABLE=true\n",
    "install-command": "pnpm install --frozen-lockfile",
    "cache-profile": "ios-e2e-budgie-v2",
    "rct-use-prebuilt-rncore": true,
    "rct-use-rn-dep": true,
    "repack-on-hit": true,
    "screenshots-download-dir": "fastlane/screenshots/landing-raw"
}
