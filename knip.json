{
    "ignore": [
        ".agents/**",
        ".claude/**",
        ".codex/**",
        "packages/landing/**",
        "packages/app/babel.config.js",
        "packages/app/lingui.config.js",
        "packages/app/fingerprint.config.js",
        "scripts/after-install.cjs",
        "tests/app-tests/scripts/prepare-date-sensitive-fixtures.js",
        "packages/sync/babel.config.js",
        "packages/amount-input/babel.config.bob.js",
        "tsconfig.json",
        "packages/contracts/src/**/*.enum.ts",
        "packages/app/scripts/bench-budget-spent.ts",
        "packages/app/scripts/generate-social-posts.mjs",
        "packages/app/scripts/social-posts/**/*.mjs",
        "packages/app/scripts/generate-icons-constant.ts",
        "packages/app/scripts/bench-util.ts"
    ],
    "ignoreDependencies": [
        "husky",
        "@lingui/cli",
        "@lingui/format-po",
        "@expo/fingerprint",
        "react-compiler-runtime",
        "@oxlint/migrate",
        "expo-pdf-text-extract",
        "babel-plugin-react-compiler",
        "eas-build-cache-provider",
        "@types/react-dom",
        "rimraf",
        "emojibase-data"
    ],
    "ignoreBinaries": [
        "build"
    ],
    "workspaces": {
        "tests/sync-tests": {
            "ignoreDependencies": [
                "@lingui/core",
                "expo-app-intents"
            ]
        },
        "e2e": {
            "entry": [
                "e2e.config.ts",
                "media.config.ts",
                "tests/**/*.e2e.ts",
                "media/**/*.e2e.ts"
            ],
            "project": [
                "**/*.ts"
            ],
            "ignoreBinaries": [
                "e2e"
            ],
            "ignoreDependencies": [
                "@mobile-ci/e2e-simlock",
                "agent-device"
            ]
        }
    }
}
