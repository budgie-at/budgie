        "expo-pdf-text-extract",
        "babel-plugin-react-compiler",
        "eas-build-cache-provider",
        "@types/react-dom",
        "rimraf",
        "lucide-static",
        "emojibase-data"
    ],
    "ignoreBinaries": ["build"],
    "workspaces": {
        "packages/categorization": {
            "tsconfig": ["tsconfig.json", "tsconfig.test.json"]
        },
        "tests/sync-tests": {
