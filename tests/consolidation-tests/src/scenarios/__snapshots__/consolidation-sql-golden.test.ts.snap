        AND (bank_entry.amount - p2p_entry.quoted_amount) * 1.0 / p2p_entry.quoted_amount <= 0.02
    )
    OR (
        p2p_source.type = 'EXPENSE'
        AND bank_source.type = 'INCOME'
        AND bank_entry.kind = 'PRIMARY'
        AND bank_entry.type = 'DEBIT'
        AND p2p_entry.quoted_amount >= bank_entry.amount
        AND p2p_entry.quoted_amount - bank_entry.amount <= 500000000
        AND (p2p_entry.quoted_amount - bank_entry.amount) * 1.0 / p2p_entry.quoted_amount <= 0.02
    )
)
) = 0
                AND (
    SELECT COUNT(DISTINCT replacement_bank_transaction.id)
    FROM transaction_entries replacement_bank_entry
    INNER JOIN transactions replacement_bank_transaction
        ON replacement_bank_transaction.id = replacement_bank_entry.transaction_id
        AND replacement_bank_transaction.deleted_at IS NULL
        AND replacement_bank_transaction.consolidation_parent_transaction_id IS NULL
         AND replacement_bank_transaction.operated_at BETWEEN 1700000000 AND 1700086401
    INNER JOIN accounts replacement_bank_account
        ON replacement_bank_account.id = replacement_bank_entry.account_id
        AND replacement_bank_account.type IN ('BANK','BANK_SYNC','SAVINGS')
        AND replacement_bank_account.instrument_id = p2p_entry.quoted_instrument_id
        AND replacement_bank_account.deleted_at IS NULL
        AND replacement_bank_account.is_active = 1
    WHERE replacement_bank_entry.deleted_at IS NULL
        AND replacement_bank_entry.original_transaction_id IS NULL
        AND replacement_bank_entry.kind = 'PRIMARY'
        AND ABS(p2p_source.operated_at - replacement_bank_transaction.operated_at) <= 3600
        AND (
    (
        p2p_source.type = 'INCOME'
        AND replacement_bank_transaction.type = 'EXPENSE'
        AND replacement_bank_entry.kind = 'PRIMARY'
        AND replacement_bank_entry.type = 'CREDIT'
        AND replacement_bank_entry.amount >= p2p_entry.quoted_amount
        AND replacement_bank_entry.amount - p2p_entry.quoted_amount <= 500000000
        AND (replacement_bank_entry.amount - p2p_entry.quoted_amount) * 1.0 / p2p_entry.quoted_amount <= 0.02
    )
    OR (
        p2p_source.type = 'EXPENSE'
        AND replacement_bank_transaction.type = 'INCOME'
        AND replacement_bank_entry.kind = 'PRIMARY'
        AND replacement_bank_entry.type = 'DEBIT'
        AND p2p_entry.quoted_amount >= replacement_bank_entry.amount
        AND p2p_entry.quoted_amount - replacement_bank_entry.amount <= 500000000
        AND (p2p_entry.quoted_amount - replacement_bank_entry.amount) * 1.0 / p2p_entry.quoted_amount <= 0.02
    )
)
) = 1
            )
        )
"
`;

