                        OR bridge_income_mcc.mcc_group_id = 10
                        OR bridge_expense_mcc.mcc_group_id = 10
                        OR target_income_mcc.mcc_group_id = 10
                    )
                    AND (source_expense_mcc.mcc_group_id IS NULL OR source_expense_mcc.mcc_group_id = 10)
                    AND (bridge_income_mcc.mcc_group_id IS NULL OR bridge_income_mcc.mcc_group_id = 10)
                    AND (bridge_expense_mcc.mcc_group_id IS NULL OR bridge_expense_mcc.mcc_group_id = 10)
                    AND (target_income_mcc.mcc_group_id IS NULL OR target_income_mcc.mcc_group_id = 10)
            )
            WHERE sourceExpenseRank = 1
                AND bridgeIncomeRank = 1
                AND bridgeExpenseRank = 1
                AND targetIncomeRank = 1
"
`;

exports[`consolidation/sql-golden > IBAN_BRIDGE_DUPLICATE_PAIR_CANDIDATES_SQL unscoped 1`] = `
"
            WITH candidate_rows AS (
                SELECT
                    pair_tx.id as pairTransactionId,
                    bridge_tx.id as bridgeTransactionId,
                    source_tx.id as sourceExpenseTransactionId,
                    target_tx.id as targetIncomeTransactionId,
                    ABS(pair_tx.operated_at - bridge_tx.operated_at) as timeDiff
                FROM transactions pair_tx
                
                INNER JOIN transaction_entries pair_source_entry ON
                    pair_source_entry.transaction_id = pair_tx.id
                    AND pair_source_entry.deleted_at IS NULL
                    AND pair_source_entry.original_transaction_id IS NULL
                    AND pair_source_entry.type = 'CREDIT'
                    AND pair_source_entry.account_id = pair_tx.from_account_id
                
                INNER JOIN transaction_entries pair_target_entry ON
                    pair_target_entry.transaction_id = pair_tx.id
                    AND pair_target_entry.deleted_at IS NULL
                    AND pair_target_entry.original_transaction_id IS NULL
                    AND pair_target_entry.type = 'DEBIT'
                    AND pair_target_entry.account_id = pair_tx.to_account_id
                
                INNER JOIN transaction_entries source_entry ON
                    source_entry.transaction_id = pair_tx.id
                    AND source_entry.deleted_at IS NULL
                    AND source_entry.type = 'CREDIT'
                    AND source_entry.account_id = pair_tx.from_account_id
                INNER JOIN transactions source_tx ON
                    source_tx.id = source_entry.original_transaction_id
                    AND source_tx.type = 'EXPENSE'
                    AND source_tx.deleted_at IS NULL
                    AND source_tx.consolidation_parent_transaction_id = pair_tx.id
                
                INNER JOIN transaction_entries target_entry ON
                    target_entry.transaction_id = pair_tx.id
                    AND target_entry.deleted_at IS NULL
                    AND target_entry.type = 'DEBIT'
                    AND target_entry.account_id = pair_tx.to_account_id
                INNER JOIN transactions target_tx ON
                    target_tx.id = target_entry.original_transaction_id
                    AND target_tx.type = 'INCOME'
                    AND target_tx.deleted_at IS NULL
                    AND target_tx.consolidation_parent_transaction_id = pair_tx.id
                INNER JOIN transactions bridge_tx ON
                    bridge_tx.type = 'TRANSFER'
                    AND bridge_tx.deleted_at IS NULL
                    AND bridge_tx.consolidation_parent_transaction_id IS NULL
                    AND bridge_tx.updated_by IS NULL
                    AND bridge_tx.consolidation_type = 'IBAN_BRIDGE_TRANSFER'
                    AND bridge_tx.from_account_id = pair_tx.from_account_id
                    AND bridge_tx.to_account_id = pair_tx.to_account_id
                    AND bridge_tx.operated_at BETWEEN pair_tx.operated_at - 60
                        AND pair_tx.operated_at + 60
                
                INNER JOIN transaction_entries bridge_source_entry ON
                    bridge_source_entry.transaction_id = bridge_tx.id
                    AND bridge_source_entry.deleted_at IS NULL
                    AND bridge_source_entry.original_transaction_id IS NULL
                    AND bridge_source_entry.type = 'CREDIT'
                    AND bridge_source_entry.account_id = bridge_tx.from_account_id
                    AND ABS(bridge_source_entry.amount - pair_source_entry.amount) <= 10000
                
                INNER JOIN transaction_entries bridge_target_entry ON
                    bridge_target_entry.transaction_id = bridge_tx.id
                    AND bridge_target_entry.deleted_at IS NULL
                    AND bridge_target_entry.original_transaction_id IS NULL
                    AND bridge_target_entry.type = 'DEBIT'
                    AND bridge_target_entry.account_id = bridge_tx.to_account_id
                    AND ABS(bridge_target_entry.amount - pair_target_entry.amount) <= 10000
                WHERE pair_tx.type = 'TRANSFER'
                    AND pair_tx.deleted_at IS NULL
                    AND pair_tx.consolidation_parent_transaction_id IS NULL
                    AND pair_tx.updated_by IS NULL
                    AND pair_tx.consolidation_type = 'TRANSFER_PAIR'
                    
                    AND (SELECT COUNT(*) FROM transactions pair_child WHERE pair_child.consolidation_parent_transaction_id = pair_tx.id) = 2
                    AND NOT EXISTS (
                        SELECT 1
                        FROM transaction_entries claimed_entry
                        WHERE claimed_entry.transaction_id = bridge_tx.id
                            AND claimed_entry.deleted_at IS NULL
                            AND claimed_entry.original_transaction_id IS NOT NULL
                            AND claimed_entry.account_id = bridge_tx.from_account_id
                    )
                    AND NOT EXISTS (
                        SELECT 1
                        FROM transaction_entries claimed_entry
                        WHERE claimed_entry.transaction_id = bridge_tx.id
                            AND claimed_entry.deleted_at IS NULL
                            AND claimed_entry.original_transaction_id IS NOT NULL
                            AND claimed_entry.account_id = bridge_tx.to_account_id
                    )
            ),
            ranked_rows AS (
                SELECT
                    *,
                    ROW_NUMBER() OVER (PARTITION BY pairTransactionId ORDER BY timeDiff, bridgeTransactionId) as pairRank,
                    ROW_NUMBER() OVER (PARTITION BY bridgeTransactionId ORDER BY timeDiff, pairTransactionId) as bridgeRank
                FROM candidate_rows
            )
            SELECT pairTransactionId, bridgeTransactionId, sourceExpenseTransactionId, targetIncomeTransactionId
            FROM ranked_rows
            WHERE pairRank = 1
                AND bridgeRank = 1
            ORDER BY pairTransactionId
"
`;

