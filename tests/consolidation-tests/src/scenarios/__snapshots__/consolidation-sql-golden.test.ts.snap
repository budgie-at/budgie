        AND (p2p_entry.quoted_amount - bank_entry.amount) * 1.0 / p2p_entry.quoted_amount <= 0.02
    )
)
) = 1
            )
            OR (
                1 = 1
                AND (
    SELECT COUNT(*)
    FROM transaction_entries bank_entry
    INNER JOIN accounts bank_account
