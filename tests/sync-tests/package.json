        "eval:categorization": "sh -c 'set -e; if [ \"$1\" = -- ]; then shift; fi; test -f \"$1\"; mkdir -p \"$HOME/.cache\" && BUDGIE_BACKUP_DB=\"$(realpath \"$1\")\" TMPDIR=\"$HOME/.cache\" vitest run src/scenarios/categorization/categorization-eval.test.ts' eval-categorization",
