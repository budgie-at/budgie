 import ExpoModulesCore
 import PDFKit
 
+private let pdfRowYTolerance: CGFloat = 3.0
+private let pdfColumnGapThreshold: CGFloat = 12.0
+private let pdfColumnGapSeparator = "    "
+
+private struct PdfVisualLine {
+    let text: String
+    let minX: CGFloat
+    let y: CGFloat
+}
+
+private func collectPdfVisualLines(on page: PDFPage) -> [PdfVisualLine] {
+    let pageBounds = page.bounds(for: .mediaBox)
+    guard let pageSelection = page.selection(for: pageBounds) else { return [] }
+    let lineSelections = pageSelection.selectionsByLine()
+    return lineSelections.compactMap { selection in
+        guard let text = selection.string, !text.isEmpty else { return nil }
+        let bounds = selection.bounds(for: page)
+        return PdfVisualLine(text: text, minX: bounds.minX, y: bounds.midY)
+    }
+}
+
+private func renderPdfRow(_ parts: [PdfVisualLine]) -> String {
+    var rendered = ""
+    var previousMinX: CGFloat?
+    for (index, part) in parts.enumerated() {
+        if let previous = previousMinX, part.minX - previous > pdfColumnGapThreshold {
+            rendered.append(pdfColumnGapSeparator)
+        } else if index > 0 && !rendered.hasSuffix(" ") {
+            rendered.append(" ")
+        }
+        rendered.append(part.text)
+        previousMinX = part.minX
+    }
+    return rendered
+}
+
+private func extractPageLayoutText(_ page: PDFPage) -> String {
+    let visualLines = collectPdfVisualLines(on: page)
+    let sorted = visualLines.sorted { lhs, rhs in
+        if abs(lhs.y - rhs.y) <= pdfRowYTolerance { return lhs.minX < rhs.minX }
+        return lhs.y > rhs.y
+    }
+
+    var renderedLines: [String] = []
+    var rowY: CGFloat?
+    var rowParts: [PdfVisualLine] = []
+
+    for line in sorted {
+        let isSameRow = rowY.map { abs($0 - line.y) <= pdfRowYTolerance } ?? false
+        if !isSameRow {
+            if !rowParts.isEmpty {
+                renderedLines.append(renderPdfRow(rowParts))
+            }
+            rowParts = []
+            rowY = line.y
+        }
+        rowParts.append(line)
+    }
+
+    if !rowParts.isEmpty {
+        renderedLines.append(renderPdfRow(rowParts))
+    }
+
+    return renderedLines.joined(separator: "\n")
+}
+
+private func extractPageTextItems(_ page: PDFPage, pageNumber: Int) -> [[String: Any]] {
+    let pageBounds = page.bounds(for: .mediaBox)
+    guard let pageSelection = page.selection(for: pageBounds) else { return [] }
+    let lineSelections = pageSelection.selectionsByLine()
+    return lineSelections.compactMap { selection in
+        guard let text = selection.string, !text.isEmpty else { return nil }
+        let bounds = selection.bounds(for: page)
+        return [
+            "text": text,
+            "x": Double(bounds.minX),
+            "y": Double(bounds.minY),
+            "width": Double(bounds.width),
+            "height": Double(bounds.height),
+            "page": pageNumber
+        ]
+    }
+}
+
